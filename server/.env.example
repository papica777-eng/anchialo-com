# ANCHIALO Melbourne Autonomous Server Environment Template
# Copy to server/.env on Akash / local runtime. NEVER commit real secrets to git.

ANCHIALO_DB_PATH=/data/anchialo.db
PUBLIC_BASE_URL=https://api.anchialo.com
STOREFRONT_URL=https://anchialo.com
ALLOWED_ORIGINS=https://anchialo.com,https://www.anchialo.com,http://localhost:8000,http://127.0.0.1:8000

# Stripe Dynamic Checkout & Webhook Commission Attribution
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend Free Tier (3,000 emails/month) OR Gmail/Google Workspace SMTP Fallback
RESEND_API_KEY=re_replace_me
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
OUTREACH_FROM_EMAIL=Sotir at Anchialo <hello@anchialoau.com>
SENDER_PHYSICAL_ADDRESS=CPT MMA / Anchialo Australia, Melbourne VIC 3000, Australia
UNSUBSCRIBE_SECRET=change_this_to_a_long_random_hmac_secret

# Akash Network Console Deploy API Key (kept out of git)
AKASH_CONSOLE_API_KEY=

# Instant Order & Warm Lead Alerts for Sotir (Zero Cost via Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Places API (New) — Free Monthly Quota with FieldMask
GOOGLE_PLACES_API_KEY=
MAX_DAILY_PLACES_CALLS=80

# Optional LLM API for B2B Email Personalization
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Throttling & Commissions
DEFAULT_PARTNER_COMMISSION_RATE=0.18
MAX_DAILY_B2B_EMAILS=25

